{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run API Functions Host",
      "type": "shell",
      "command": "func start",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "options": {
        "cwd": "${workspaceFolder}/Api"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run UI Dev Server",
      "type": "shell",
      "command": "dotnet run --project Client",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Build Everything",
      "type": "shell",
      "command": "dotnet build BigBeerData.sln",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    }
  ]
}
