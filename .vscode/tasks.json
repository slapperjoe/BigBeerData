{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Database",
      "type": "shell",
      "command": "docker compose up -d",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Run API Functions Host",
      "type": "shell",
      "command": "func start",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}/Api"
      },
      "isBackground": true,
      "dependsOn": [
        "Start Database",
        "Build Everything"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": {
        "pattern": {
          "regexp": "Worker process started and initialized"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting worker process",
          "endsPattern": "Worker process started and initialized"
        }
      }
    },
    {
      "label": "Run UI Dev Server",
      "type": "shell",
      "command": "dotnet run --project Client",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Build Everything",
      "type": "shell",
      "command": "dotnet build BigBeerData.sln",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Build VisualisationInterop (webpack)",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/VisualisationInterop"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run WebApp",
      "type": "shell",
      "command": "dotnet watch run --project WebApp",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}